{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Throttling": {
    "Rules": [
      {
        "Name": "default",
        "IsDefault": true,
        "Key": "global",
        "Period": "minute",
        "MaxActiveRequests": 8,
        "MaxTotalRequests": 16,
        "MaxSleep": "00:00:01"
      },
      {
        "Name": "create-order",
        "Key": "endpoint",
        "Endpoint": "POST /orders",
        "Period": "minute",
        "MaxActiveRequests": 2,
        "MaxTotalRequests": 4,
        "MaxSleep": "00:00:01"
      }
    ]
  }
}
